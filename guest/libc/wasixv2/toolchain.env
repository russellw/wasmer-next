# Toolchain pins for wasixv2/build-sysroot.sh, wasixv2/fetch-llvm.sh and CI.
# Sourced by POSIX sh: KEY=value only, no spaces around '='.

# LLVM version. compiler-rt builtins are built from this llvm-project tag,
# and CI compiles libc2 with the matching upstream release.
LLVM_VERSION=22.1.8
# Commit that the llvmorg-$LLVM_VERSION tag points to (checked after fetching).
LLVM_COMMIT=ca7933e47d3a3451d81e72ac174dcb5aa28b59d1
LLVM_REPO=https://github.com/llvm/llvm-project.git

# Upstream binary release used by CI (wasixv2/fetch-llvm.sh).
LLVM_TARBALL=LLVM-22.1.8-Linux-X64.tar.xz
LLVM_TARBALL_SHA256=df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384

# Linux release whose UAPI headers (linux/, asm/, asm-generic/, ...) the
# sysroot ships, installed for ARCH=riscv: wasixv2's struct layouts and
# constants follow riscv32. The newest release covering wasixv2's syscall table.
LINUX_UAPI_TAG=v7.2
# Commit that the tag points to (checked after fetching).
LINUX_UAPI_COMMIT=8d3ae59288f1e7d58d76558a6ee96d533bc5019f
LINUX_REPO=https://github.com/torvalds/linux.git

# wasm-tools used by the smoke test in CI.
WASM_TOOLS_VERSION=1.259.0

